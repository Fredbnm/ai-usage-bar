# Language stats on GitHub (Linguist).
# The website lives in docs/, which Linguist would skip as documentation.
docs/index.html linguist-documentation=false
# Sample API responses are test data, not source.
docs/*.json linguist-documentation
# Binary assets.
*.png binary
*.ico binary
*.icns binary
# Shell scripts run on Linux and macOS: keep LF even in a Windows checkout.
*.sh text eol=lf
linux/packaging/AppRun text eol=lf
linux/packaging/*.desktop text eol=lf
