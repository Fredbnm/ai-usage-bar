<Window x:Class="AIUsageBar.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Bar widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Replaced from code to follow the taskbar's light/dark theme. -->
        <SolidColorBrush x:Key="WidgetPill" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="WidgetPillBorder" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="WidgetChipHover" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="WidgetText" Color="#F2FFFFFF" />
    </Window.Resources>

    <Grid>
        <!-- One pill, a chip per agent: ringed official icon + percentage. Hover for the details, click for the popup. -->
        <Border x:Name="Pill" Height="36" CornerRadius="18" BorderThickness="1" Padding="3,0"
                Background="{DynamicResource WidgetPill}" BorderBrush="{DynamicResource WidgetPillBorder}"
                TextElement.Foreground="{DynamicResource WidgetText}">
            <ItemsControl ItemsSource="{Binding Chips}" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Chip" Tag="chip" Height="30" CornerRadius="15" Margin="1,0" Padding="{Binding ChipPadding}"
                                Background="Transparent" Cursor="Hand" AutomationProperties.Name="{Binding Spoken}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="24" Height="24" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Margin="6,0,0,1" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Text="{Binding Percent}" Foreground="{Binding PercentBrush}"
                                           Visibility="{Binding PercentVisibility}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WidgetChipHover}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- The hover card: the same card as in the popup, for the agent under the mouse. -->
        <Popup x:Name="Hover" AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="Fade">
            <Border x:Name="HoverCard" Margin="8" Width="324" Padding="16,4,16,14" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}"
                    TextElement.Foreground="{DynamicResource PrimaryText}" TextElement.FontSize="13">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.28" />
                </Border.Effect>
                <ContentControl x:Name="HoverContent" Focusable="False" ContentTemplate="{StaticResource ProviderCardTemplate}" />
            </Border>
        </Popup>
    </Grid>
</Window>
