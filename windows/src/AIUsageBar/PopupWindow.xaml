<Window x:Class="AIUsageBar.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Bar"
        Width="356"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Border x:Name="Card" Margin="8" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}"
            TextElement.Foreground="{DynamicResource PrimaryText}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.28" />
        </Border.Effect>

        <StackPanel Margin="16,14,16,10">
            <!-- Header -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="{Binding RefreshTip}" Command="{Binding RefreshCommand}"
                        Visibility="{Binding RefreshVisibility}" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontFamily="{StaticResource IconFont}" Text="&#xE895;" Foreground="{DynamicResource SecondaryText}"
                           Visibility="{Binding LoadingVisibility}" />
            </Grid>

            <!-- Tab strip: one tab per agent plus the Agents tab. Hidden with a single agent. -->
            <DockPanel Margin="0,8,0,0" Visibility="{Binding TabStripVisibility}">
                <!-- "＋" keeps a narrow slot of its own; the agent tabs share the rest equally. -->
                <Button DockPanel.Dock="Right" Width="30" Style="{StaticResource TabButton}"
                        DataContext="{Binding AgentsTab}" Command="{Binding SelectCommand}" Tag="{Binding UnderlineBrush}"
                        AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding AutomationName}">
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding NameWeight}" Foreground="{Binding StatusBrush}" />
                </Button>
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TabButton}" Width="{Binding Width}" Command="{Binding SelectCommand}"
                                    Tag="{Binding UnderlineBrush}" AutomationProperties.Name="{Binding AutomationName}"
                                    ToolTip="{Binding AutomationName}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="16" Height="16" Source="{Binding Icon}" Opacity="{Binding IconOpacity}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Margin="4,0,0,0" FontSize="12.5" Text="{Binding Name}" FontWeight="{Binding NameWeight}"
                                               Visibility="{Binding NameVisibility}" />
                                    <TextBlock Margin="3,0,0,0" FontSize="11" FontWeight="SemiBold"
                                               Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                               Visibility="{Binding StatusVisibility}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Agents tab: every supported agent and whether it is connected. -->
            <StackPanel DataContext="{Binding Agents}" Visibility="{Binding DataContext.AgentsVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Height="1" Margin="0,0,0,12" Background="{DynamicResource Divider}" />
                <TextBlock Text="{Binding Heading}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Welcome}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SecondaryText}" Visibility="{Binding WelcomeVisibility}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,2,0,0" VerticalAlignment="Top" FontFamily="{StaticResource IconFont}"
                                           Text="{Binding Icon}" Foreground="{Binding IconBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Hint}" TextWrapping="Wrap" FontSize="11.5"
                                               Visibility="{Binding HintVisibility}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" VerticalAlignment="Top" Content="{Binding ToggleText}" IsChecked="{Binding IsShown, Mode=OneWay}"
                                          Command="{Binding ToggleCommand}" Visibility="{Binding ToggleVisibility}" Focusable="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Margin="0,14,0,0" HorizontalAlignment="Right" Padding="14,4" Content="{Binding DoneText}"
                        Command="{Binding DoneCommand}" Visibility="{Binding DoneVisibility}" />
            </StackPanel>

            <!-- The selected service -->
            <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Height="1" Margin="0,12,0,12" Background="{DynamicResource Divider}" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProviderCardTemplate}" Focusable="False" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Footer -->
            <Border Height="1" Margin="0,12,0,6" Background="{DynamicResource Divider}" />
            <Button x:Name="SettingsButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                    Content="&#xE713;" ToolTip="{Binding SettingsTip}" Click="OnSettingsClick" />
        </StackPanel>
    </Border>
</Window>
